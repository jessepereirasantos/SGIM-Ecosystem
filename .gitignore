# SGIM Ecosystem Git Ignore
.idea/
.vscode/
node_modules/
vendor/
*.log
*.rar
tmp/
temp/
cache/

# ZIPs de OTA (gerados pelo servidor Master - não rastrear no git, são grandes)
SGIM-VENDAS/api/update/packages/*.zip
SGIM-VENDAS/source_cliente/*.zip
SGIM-CLIENTE/*.zip

# Configurações sensíveis (Não subir para o GitHub por segurança)
db_config.php
config/db_config.php
SGIM-CLIENTE/config/db_config.php
SGIM-VENDAS/config/db_config.php
SGIM-VENDAS/cliente-atualizacao/config/db_config.php

# Arquivos de sistema
.DS_Store
Thumbs.db

# Resgate e Tokens
.rescue_token.php
SGIM-CLIENTE/.rescue_token.php

# Pastas de transição OTA (geradas em runtime no servidor)
releases/
SGIM-CLIENTE/releases/
